{#-
  The Studio Letter band: the signup on the pink band. "feature" puts a painting beside it,
  for the /studio-letter/ page (the old one-page site, rebuilt from parts).
  {% from "patterns/signup-band/signup-band.njk" import signupBand %}
  {{ signupBand({ id: "home-signup" }) }}  {{ signupBand({ id: "letter", feature: image, headingLevel: 1 }) }}
-#}
{%- from "components/email-signup/email-signup.njk" import emailSignup -%}
{%- from "components/artwork-image/artwork-image.njk" import artworkImage -%}
{%- from "components/logo/logo.njk" import flowerMark -%}
{%- macro signupBand(opts = {}) -%}
<div class="ds-signup-band{% if opts.feature %} ds-signup-band--feature{% endif %}">
  {%- if opts.feature %}
  <div class="ds-signup-band__art">{{ artworkImage(opts.feature, { priority: opts.priority, sizes: "(width >= 53.75rem) 50vw, 100vw" }) }}</div>
  {%- endif %}
  <div class="ds-signup-band__panel">
    {{ flowerMark({ class: "ds-signup-band__mark" }) }}
    {{ emailSignup({ id: opts.id or "band-signup", onBand: true, headingLevel: opts.headingLevel or 2 }) }}
  </div>
</div>
{%- endmacro -%}
