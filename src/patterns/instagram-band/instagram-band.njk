{#-
  Instagram: the three latest posts, each linking to the post. They're fetched and resized at
  build time (scripts/instagram.js), so there's no embed, third-party script or tracking.
  Without an Instagram token it falls back to studio photos linking to the profile, or their
  short clip if the photo has one.
  {% from "patterns/instagram-band/instagram-band.njk" import instagramBand %}
  {{ instagramBand({ id: "instagram", posts: instagram.posts, photos: shop.photos.studio }) }}
-#}
{%- from "components/icon/icon.njk" import icon -%}
{%- from "components/artwork-image/artwork-image.njk" import artworkImage -%}
{%- from "components/video-clip/video-clip.njk" import videoClip -%}
{%- macro instagramBand(opts = {}) -%}
<div class="ds-instagram">
  <div class="ds-instagram__head">
    <h2 class="ds-instagram__title" id="{{ opts.id or 'instagram' }}">{{ opts.heading or "From the studio" }}</h2>
    <p>Paintings in progress, the odd brush clean, and new work before it's in the shop.</p>
    <a class="ds-instagram__handle" href="{{ site.instagram }}" target="_blank" rel="noopener">{{ icon("instagram", { size: "md" }) }}<span>Follow {{ site.instagramHandle }}<span class="ds-visually-hidden"> on Instagram (opens in a new tab)</span></span></a>
  </div>
  {%- if opts.posts and opts.posts.length %}
  <ul class="ds-instagram__photos" role="list">
    {%- for post in opts.posts | batch(3) | first %}
    <li><a class="ds-instagram__photo" href="{{ post.permalink }}" target="_blank" rel="noopener"><img src="{{ post.src }}" srcset="{{ post.srcset }}" sizes="(width &gt;= 53.75rem) 20vw, 33vw" width="{{ post.width }}" height="{{ post.height }}" alt="{{ post.alt }}" loading="lazy" decoding="async"><span class="ds-visually-hidden"> (opens in a new tab)</span></a></li>
    {%- endfor %}
  </ul>
  {%- elif opts.photos and opts.photos.length %}
  <ul class="ds-instagram__photos" role="list">
    {%- for photo in opts.photos | batch(3) | first %}
    {%- if photo.video %}
    <li class="ds-instagram__photo">{{ videoClip(photo.video, photo.image, { framed: true }) }}</li>
    {%- else %}
    <li><a class="ds-instagram__photo" href="{{ site.instagram }}" target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">{{ artworkImage(photo.image, { alt: "", sizes: "(width >= 53.75rem) 25vw, 33vw" }) }}</a></li>
    {%- endif %}
    {%- endfor %}
  </ul>
  {%- endif %}
</div>
{%- endmacro -%}
