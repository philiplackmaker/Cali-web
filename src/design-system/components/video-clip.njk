<header class="docs-header">
  <p class="docs-eyebrow">Component · Web Component</p>
  <h1>Video clip</h1>
  <p class="docs-lede">A living photo: a few seconds of a brush at work or a painting being unwrapped, playing silently on a loop. Cali adds a clip next to a photo in the admin; the photo is the poster and the fallback.</p>
</header>

<section class="docs-section" aria-labelledby="use">
  <h2 id="use">Use it</h2>
  {% set code %}{% raw %}{% from "components/video-clip/video-clip.njk" import videoClip %}
{{ videoClip(photo.video, photo.image) }}
{{ videoClip(product.clip, product.featuredImage, { framed: true }) }}{% endraw %}{% endset %}
  {{ usage(code) }}
  {{ props([
    ["clip", "{ url, type, label }", "From the admin's Clip fields, via scripts/content.js. label is “What the clip shows”, read out by screen readers."],
    ["poster", "Image", "Shown until the clip plays, sized like artwork-image. Sets width and height, so there's no layout shift."],
    ["framed", "boolean", "Fixed-ratio frame, to line up with framed photos (the studio strip). The clip fills it."]
  ]) }}
</section>

