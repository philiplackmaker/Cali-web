# The shop's products: Cali's Google Sheet. Paste the sheet's normal link (…/edit#gid=0) or a
# "Publish to web" CSV link. The sheet must be shared as "Anyone with the link can view".
# Without it, builds use the local copy in scripts/local-catalogue.js.
SHEET_CSV_URL=
# Optional: the sheet's Photos tab (Placement, Image, Alt text, Caption, Order), for the home
# page painting, the About photo and the studio photos. Use that tab's own link (its gid).
SHEET_PHOTOS_CSV_URL=

# Stripe secret key, for the checkout function (netlify/functions/checkout.mjs).
# Use sk_test_… until launch, then sk_live_…. Netlify only: never commit a real key.
STRIPE_SECRET_KEY=

# Instagram API (Instagram Login) long-lived token, for the latest 3 posts on the home and
# About pages. Without it, those spots show the studio photos. See "Instagram" in the README.
INSTAGRAM_ACCESS_TOKEN=

# Netlify only (Site configuration → Environment variables), for the nightly rebuild:
NETLIFY_BUILD_HOOK_URL=
