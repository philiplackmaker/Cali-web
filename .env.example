# Products and photos are files in content/, edited at /admin/ (README → The admin).
# Nothing to set for them.

# Stripe secret key, for the checkout function (netlify/functions/checkout.mjs) and
# /api/health. Use sk_test_… until launch, then sk_live_…. Netlify only: never commit a real key.
STRIPE_SECRET_KEY=

# Cloudflare Web Analytics site token (visitor stats, no cookies). Production builds only.
CLOUDFLARE_ANALYTICS_TOKEN=

# Instagram API (Instagram Login) long-lived token, for the latest 3 posts on the home and
# About pages. Without it, those spots show the studio photos. See "Instagram" in the README.
INSTAGRAM_ACCESS_TOKEN=

# Netlify only (Site configuration → Environment variables), for the nightly rebuild:
NETLIFY_BUILD_HOOK_URL=
