# Shopify → Headless sales channel → Storefront API (public access token).
# With both set, builds fetch live products. Without them, the site uses the mock catalogue.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
# Set to 1 to force the mock catalogue even when the two above are set.
SHOPIFY_MOCK=

# Instagram API (Instagram Login) long-lived token, for the latest 3 posts on the home and
# About pages. Without it, those spots show the studio photos. See "Instagram" in the README.
INSTAGRAM_ACCESS_TOKEN=

# Netlify only (Site configuration → Environment variables), for the nightly rebuild:
NETLIFY_BUILD_HOOK_URL=
