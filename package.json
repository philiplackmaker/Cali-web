{
  "name": "calico-melton-shop",
  "private": true,
  "type": "module",
  "description": "Calico Melton's shop: Eleventy + Web Components + Shopify Storefront API.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.js",
    "contrast": "node scripts/check-contrast.js",
    "dev": "npm run tokens && eleventy --serve",
    "build": "npm run tokens && npm run contrast && eleventy",
    "lint": "npm run lint:css && npm run lint:js && npm run format:check",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:js": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "build:e2e": "SHOPIFY_STORE_DOMAIN=e2e-shop.myshopify.com SHOPIFY_STOREFRONT_TOKEN=e2e-public-token node --import ./tests/support/fake-storefront.mjs node_modules/@11ty/eleventy/cmd.cjs --output=_site-e2e",
    "test:e2e": "playwright test",
    "check:site": "node tests/site/check-site.js _site",
    "lighthouse": "lhci autorun",
    "quality": "npm run lint && npm test && npm run build && npm run check:site && npm run test:e2e && npm run lighthouse",
    "check:launch": "node tests/site/check-site.js _site --launch"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "nunjucks": "^3.2.4",
    "prettier": "^3.9.10",
    "style-dictionary": "^5.8.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0"
  }
}
